# FixMyHyd - Production Environment Configuration for Render
# Copy these settings to Render dashboard → Environment Variables
# Do NOT commit this file to git - use .env.example as template instead

# ==================== FLASK CONFIGURATION ====================
FLASK_ENV=production
SECRET_KEY=<GENERATE: python -c "import secrets; print(secrets.token_hex(32))">
PORT=10000

# ==================== RENDER & PORTAL SETTINGS ====================
# Render automatically provides RENDER_EXTERNAL_URL or similar
# Set this to your Render web service URL when deploying the bot worker
PORTAL_BASE_URL=https://your-app-name.onrender.com

# ==================== DATABASE (PostgreSQL) ====================
# Render PostgreSQL automatically sets DATABASE_URL
# This will be provided automatically - DO NOT set manually
# Example format: postgresql://user:password@host:5432/dbname
# DATABASE_URL=<AUTO-PROVIDED BY RENDER>

# ==================== CLOUDINARY (Image Storage) ====================
# Sign up at https://cloudinary.com (free tier available)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_key

# ==================== GOOGLE GEMINI API KEYS ====================
# Get keys from https://aistudio.google.com/app/apikey
# Recommendation: Use separate keys for different services to manage quota
GOOGLE_API_KEY_IMAGE=your_gemini_api_key_for_image_analysis
GOOGLE_API_KEY_AUDIO=your_gemini_api_key_for_audio_transcription
GOOGLE_API_KEY_TEXT=your_gemini_api_key_for_text_analysis
GOOGLE_API_KEY_REPORT=your_gemini_api_key_for_report_generation

# ==================== TELEGRAM BOT ====================
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_URL=https://t.me/FixMyHYDbot

# ==================== PERFORMANCE & SECURITY ====================
# Render automatically sets some values, but these are recommended:
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE=Lax

# ==================== NOTES ====================
# 1. Generate SECRET_KEY using: python -c "import secrets; print(secrets.token_hex(32))"
# 2. DATABASE_URL is auto-provided by Render PostgreSQL service
# 3. Cloudinary free tier: 10GB storage, 25M monthly transformations
# 4. All API keys should be kept secret - never commit this file
# 5. Use Render dashboard's built-in variable manager to set these
# 6. Test deployment at https://your-app-name.onrender.com after setting all variables
