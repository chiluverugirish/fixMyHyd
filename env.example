# FixMyHyd Environment Configuration (v1.0.0)
# Copy this file to .env and fill in your values

# Application
APP_NAME=FixMyHyd
VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fixmyhyd
DATABASE_PATH=fixmyhyd.db

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI Providers - Gemini
GOOGLE_API_KEY_IMAGE=your-gemini-api-key
GOOGLE_API_KEY_AUDIO=your-gemini-api-key
GOOGLE_API_KEY_TEXT=your-gemini-api-key
GOOGLE_API_KEY_REPORT=your-gemini-api-key

# AI Providers - Groq
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_AUDIO_MODEL=whisper-large-v3

# AI Timeouts
GEMINI_TIMEOUT=25
GROQ_TIMEOUT=25
CLOUDINARY_TIMEOUT=30
GEOCODE_TIMEOUT=8

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_URL=https://t.me/FixMyHYDbot

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# URLs
PORTAL_BASE_URL=http://localhost:8000
RENDER_EXTERNAL_URL=

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5001
