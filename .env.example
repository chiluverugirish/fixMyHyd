# ==================== TELEGRAM BOT ====================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_URL=https://t.me/FixMyHYDbot

# ==================== FASTAPI PORTAL ====================
SECRET_KEY=change_this_to_a_random_secret
DEBUG=true
PORT=8000
PORTAL_BASE_URL=http://localhost:8000

# ==================== DATABASE ====================
# Leave empty for SQLite (development).
# Set to a PostgreSQL URL for production.
DATABASE_URL=
DATABASE_PATH=fixmyhyd.db

# ==================== CLOUDINARY (Image Storage) ====================
# Sign up free at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================== AI PROVIDERS - GEMINI ====================
# Recommend using separate keys to spread quota limits.
GOOGLE_API_KEY_IMAGE=your_gemini_api_key
GOOGLE_API_KEY_AUDIO=your_gemini_api_key
GOOGLE_API_KEY_TEXT=your_gemini_api_key
GOOGLE_API_KEY_REPORT=your_gemini_api_key

# ==================== AI PROVIDERS - GROQ ====================
# Optional fallback provider if Gemini is rate-limited or unavailable.
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_AUDIO_MODEL=whisper-large-v3

# ==================== CELERY & REDIS ====================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/0

# ==================== TIMEOUTS (External APIs) ====================
GEMINI_TIMEOUT=25
GROQ_TIMEOUT=25
CLOUDINARY_TIMEOUT=30
GEOCODE_TIMEOUT=8

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5001
