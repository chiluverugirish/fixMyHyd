# ==================== TELEGRAM BOT ====================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_URL=https://t.me/FixMyHYDbot

# ==================== FLASK PORTAL ====================
SECRET_KEY=change_this_to_a_random_secret
FLASK_ENV=development
PORT=5001

# URL of the Flask portal (bot uses this to call the backend API)
# For local dev: http://localhost:5001
# For production: https://your-render-app.onrender.com
PORTAL_BASE_URL=http://localhost:5001

# ==================== GEMINI API KEYS ====================
# Recommend using separate keys to spread quota limits.
# All four can be the same key if quota is not a concern.
GOOGLE_API_KEY_IMAGE=your_gemini_api_key
GOOGLE_API_KEY_AUDIO=your_gemini_api_key
GOOGLE_API_KEY_TEXT=your_gemini_api_key
GOOGLE_API_KEY_REPORT=your_gemini_api_key

# ==================== DATABASE ====================
# Leave empty for SQLite (development).
# Set to a PostgreSQL URL for production (e.g. Render's DATABASE_URL).
# Render PostgreSQL automatically provides this as DATABASE_URL
DATABASE_URL=
DATABASE_PATH=fixmyhyd.db

# ==================== CLOUDINARY (Image Storage) ====================
# Sign up free at: https://cloudinary.com
# Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
